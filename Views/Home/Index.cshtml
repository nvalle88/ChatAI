@* Views/Home/Index.cshtml *@
@{
    ViewData["Title"] = "Chat - ChatAI";
    Layout = "_Layout";
}

<div class="chat-container">
    <div class="chat-header">
        <h4><i class="fas fa-robot me-2"></i> ChatAI</h4>
    </div>
    <div class="chat-messages" id="messages"></div>
    <footer class="chat-input-container">
        <div class="chat-input">
            <textarea id="messageInput" rows="1" placeholder="How can Grok help?"></textarea>
            <button class="btn-grok" onclick="sendMessage()">
                <i class="fas fa-paper-plane me-2"></i> Send
            </button>
            <button class="stop-button" id="stopButton" onclick="stopTyping()">
                <i class="fas fa-stop me-2"></i> Stop
            </button>
            <button class="action-btn" id="deepSearchBtn" disabled>
                <i class="fas fa-search"></i> DeepSearch
            </button>
            <button class="action-btn" id="thinkBtn" disabled>
                <i class="fas fa-lightbulb"></i> Think
            </button>
            <div class="version-dropdown">
                <button class="btn dropdown-toggle" type="button" id="versionDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-cog me-2"></i> Grok 3
                </button>
                <ul id="versionList" class="dropdown-menu" aria-labelledby="versionDropdown">
                </ul>
            </div>
        </div>
    </footer>
</div>
