<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatAI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/messages.css" /> <!-- Re-added messages.css -->
    <link rel="stylesheet" href="/css/buttons.css" />
</head>
<body>
    <main role="main">
        <div id="messages" class="chat-messages">
            <!-- Messages will be appended here -->
        </div>
        @RenderBody()
    </main>
    <footer class="chat-input-container">
        <div class="chat-input">
            <textarea id="messageInput" rows="1" placeholder="How can Grok help?"></textarea>
            <button class="btn-grok" onclick="sendMessage()">
                <i class="fas fa-paper-plane me-2"></i> Send
            </button>
            <button class="stop-button" id="stopButton" onclick="stopTyping()">
                <i class="fas fa-stop me-2"></i> Stop
            </button>
            <button class="action-btn" id="deepSearchBtn" disabled>
                <i class="fas fa-search"></i> DeepSearch
            </button>
            <button class="action-btn" id="thinkBtn" disabled>
                <i class="fas fa-lightbulb"></i> Think
            </button>
            <div class="version-dropdown">
                <button class="btn dropdown-toggle" type="button" id="versionDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-cog me-2"></i> Grok 3
                </button>
                <ul class="dropdown-menu" aria-labelledby="versionDropdown">
                    <li><a class="dropdown-item" href="#" onclick="setVersion('v1')">laura-1</a></li>
                    <li><a class="dropdown-item" href="#" onclick="setVersion('v2')">laura-2</a></li>
                    <li><a class="dropdown-item" href="#" onclick="setVersion('v3')">Grok 3</a></li>
                </ul>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let isTyping = false;
        let typingTimeout;
        let dotCount = 0;
        let typingAnimation;
        let currentVersion = 'v2';

        const messagesDiv = document.getElementById('messages');
        const messageInput = document.getElementById('messageInput');
        const stopButton = document.getElementById('stopButton');
        const versionButton = document.getElementById('versionDropdown');

        async function sendMessage() {
            const message = messageInput.value.trim();
            if (!message) return;

            addMessage(message, 'user-message');
            messageInput.value = '';

            const typingIndicator = addMessage('', 'ai-message');
            stopButton.style.display = 'inline-block'; // Show stop button
            startTypingAnimation(typingIndicator);

            try {
                const response = await $.ajax({
                    url: '/Chat/SendMessage',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ prompt: message, version: currentVersion })
                });

                clearInterval(typingAnimation);
                if (response.success) {
                    isTyping = true;
                    await typeMessage(response.response, typingIndicator);
                    isTyping = false;
                    stopButton.style.display = 'none'; // Hide stop button
                } else {
                    typingIndicator.innerHTML = formatMarkdown('Error: ' + response.error);
                    stopButton.style.display = 'none';
                }
            } catch (error) {
                clearInterval(typingAnimation);
                typingIndicator.innerHTML = formatMarkdown('Error en la conexión: ' + error.statusText);
                stopButton.style.display = 'none';
            }
        }

        function addMessage(text, className) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${className}`;
            messageDiv.innerHTML = formatMarkdown(text);
            messagesDiv.appendChild(messageDiv);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
            return messageDiv;
        }

        async function typeMessage(text, messageDiv) {
            const formattedText = formatMarkdown(text);
            for (let i = 0; i < text.length; i++) {
                if (!isTyping) break;
                messageDiv.innerHTML = formatMarkdown(text.substring(0, i + 1));
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
                await new Promise(resolve => {
                    typingTimeout = setTimeout(resolve, 5);
                });
            }
            messageDiv.innerHTML = formattedText;
            messagesDiv.scrollTop = messagesDiv.scrollHeight - messagesDiv.clientHeight + 50;
        }

        function stopTyping() {
            isTyping = false;
            clearTimeout(typingTimeout);
            clearInterval(typingAnimation);
            stopButton.style.display = 'none';
            const messageDiv = messagesDiv.lastChild;
            if (messageDiv && messageDiv.className.includes('ai-message')) {
                messageDiv.innerHTML = formatMarkdown(messageDiv.textContent + ' [Interrumpido]');
            }
        }

        function startTypingAnimation(typingIndicator) {
            dotCount = 0;
            typingAnimation = setInterval(() => {
                dotCount = (dotCount + 1) % 4;
                const dots = '.'.repeat(dotCount);
                typingIndicator.textContent = `Buscando${dots}`;
            }, 500);
        }

        function setVersion(version) {
            currentVersion = version;
            const buttonText = getModelName(version);
            versionButton.innerHTML = `<i class="fas fa-cog me-2"></i> ${buttonText}`;
        }

        function getModelName(version) {
            return version === 'v1' ? 'laura-1' :
                version === 'v2' ? 'laura-2' :
                    version === 'v3' ? 'Grok 3' : 'laura-2';
        }

        function formatMarkdown(text) {
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/`(.*?)`/g, '<code>$1</code>')
                .replace(/^###\s(.*)$/gm, '<h3>$1</h3>')
                .replace(/^##\s(.*)$/gm, '<h2>$1</h2>')
                .replace(/^#\s(.*)$/gm, '<h1>$1</h1>');
        }

        messageInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
    </script>
</body>
</html>